# DocMind AI Environment Variables

# Environment
APP_ENV=development
DEBUG=True
API_V1_STR=/api

# LLM Providers (Groq is preferred, with OpenAI fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Database & Vector Store (PostgreSQL with pgvector)
# Use sqlite+aiosqlite:///./docmind.db for local dev fallback or postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://docmind_user:docmind_password@localhost:5432/docmind_db
VECTOR_DIMENSION=384

# Embeddings & Reranking
# BAAI/bge-small-en-v1.5 (384 dim) or all-MiniLM-L6-v2 (384 dim)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./storage/documents

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
